#!/usr/bin/env python3
"""aninext launcher - works from a checkout without installing anything.

    ./aninext-cli search frieren
    ./aninext-cli doctor

install.sh copies this to $PREFIX/bin/aninext.
"""
import os
import sys

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))

from aninext.cli import main  # noqa: E402

if __name__ == "__main__":
    sys.exit(main())
